# Environment for the IB Gateway systemd unit (read by run-gateway.sh).
# Installed to /etc/ibkr/gateway.env. Adjust paths to your machine.

# Major version of the installed offline IB Gateway, e.g. from
# "Build 10.45.1g" -> 1045 (drop the period after the first part).
TWS_MAJOR_VRSN=1045

IBC_PATH=/opt/ibc
TWS_PATH=/home/CHANGE_ME/Jts
TWS_SETTINGS_PATH=/home/CHANGE_ME/Jts
IBC_INI=/etc/ibkr/config.ini

TRADING_MODE=paper
TWOFA_TIMEOUT_ACTION=exit

LOG_PATH=/var/log/ibkr/ibc

# GUI display. WSLg provides :0; use an Xvfb display (e.g. :99) if headless.
DISPLAY=:0
