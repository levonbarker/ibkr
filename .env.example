# IB Gateway / TWS connection (env vars override config.yaml)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=10

# Paper trading account IDs to manage (comma-separated). Leave blank to use
# whatever the Gateway reports via managedAccounts().
IBKR_ACCOUNTS=

# IBC credentials (used only by the Gateway launcher, not by this app)
# TWS_USERID=
# TWS_PASSWORD=
